DEBUG=1
SECRET_KEY=change-me-local-development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
POSTGRES_DB=freight_platform
POSTGRES_USER=freight_user
POSTGRES_PASSWORD=freight_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Calculator access is enforced by Django sessions and CalculatorUserProfile.
# Retained only for compatibility with a possible future trusted-proxy integration.
CALCULATOR_REQUIRE_AUTH=1
EXTERNAL_AUTH_HEADER=HTTP_X_AUTH_USER

# Manual fuel import
FUEL_SOURCE_URL=https://www.poscat.com.au/fuelsc/fuel.csv
FUEL_FETCH_TIMEOUT_SECONDS=30
FUEL_RATE_MAX=1.0
MEDIA_ROOT=/app/uploaded_data

# Isolated saved estimates, print/PDF, history and internal exports.
SAVED_ESTIMATES_ENABLED=1
